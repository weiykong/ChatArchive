{
  "manifest_version": 3,
  "name": "ChatArchive",
  "version": "1.13.0",
  "description": "Save your AI chat conversations as clean local files in the format you choose. No account, no server, fully private.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "clipboardWrite",
    "offscreen",
    "sidePanel"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "commands": {
    "stop-and-save-export": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Stop the current export and save captured messages"
    },
    "copy-chat-to-clipboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Extract the current chat and copy it to the clipboard"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "offscreen": {
    "reasons": ["DOM_PARSER", "BLUETOOTH", "LOCAL_STORAGE", "WORKERS"],
    "minimize": true
  }
}